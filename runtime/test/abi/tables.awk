# Reads runtime/src/abi.auk and a runtime/src/cfacts.<os>-<arch>.auk and writes the generated
# halves of the layout probe (run.sh): AUK (an Auk module, the export fns `auk_probe` and
# `auk_probe_init`) and C (a C function `check_tables`), which compare every size, alignment,
# field offset and constant the Auk side declares with what the C compiler says.
#
# The files' conventions (abi.auk's header, runtime/gen/cfacts.c): each struct is preceded by
# `/// C: <C type>[; <auk field>=<C member> ...]` or `/// C: <C type>; opaque` and has one field
# per line; padding fields are `_pad<n>`; in abi.auk every `pub raw let X` is C's `AUK_X`, in
# cfacts every C-derived `pub raw let` ends with `// C: <C expression>`.
#
#   awk -v AUK=<out.auk> -v C=<out.c> -f tables.awk abi.auk cfacts.<os>-<arch>.auk

BEGIN { k = 0; ki = 0 }

FNR == 1 {
  mod = FILENAME ~ /abi\.auk$/ ? "abi" : "cfacts"
  ctype = ""; spec = ""; instruct = 0
}

function emit(aexpr, cexpr, label) {
  aukt[k] = "    " k " => i64(" aexpr ")"
  ct[k] = "    {(int64_t)(intptr_t)(" cexpr "), \"" label "\"},"
  k++
}

/^\/\/\/ C: / {
  s = substr($0, 8)
  i = index(s, "; ")
  if (i > 0) { ctype = substr(s, 1, i - 1); spec = substr(s, i + 2) } else { ctype = s; spec = "" }
  next
}

/^pub raw (struct|union) / {
  name = $4
  if (ctype == "") { print "tables.awk: " FILENAME ": no `/// C:` line before " name > "/dev/stderr"; exit 1 }
  isunion = $3 == "union"
  opaque = spec == "opaque"
  delete ren
  if (!opaque && spec != "") {
    n = split(spec, parts, " ")
    for (j = 1; j <= n; j++) { split(parts[j], kv, "="); ren[kv[1]] = kv[2] }
  }
  cof[mod "." name] = ctype
  t = mod "." name
  emit("raw.size_of<" t ">()", "sizeof(" ctype ")", "sizeof " ctype)
  emit("raw.align_of<" t ">()", "_Alignof(" ctype ")", "_Alignof " ctype)
  instruct = 1
  next
}

instruct && /^}/ { instruct = 0; ctype = ""; next }

instruct {
  f = $1
  sub(/:$/, "", f)
  if (f ~ /^_pad/ || opaque || isunion) next
  cf = (f in ren) ? ren[f] : f
  emit("raw.offset_of<" t ">(." f ")", "offsetof(" ctype ", " cf ")", "offsetof(" ctype ", " cf ")")
  next
}

/^pub raw let / {
  nm = $4; sub(/:$/, "", nm)
  ty = $5
  if (mod == "abi") { cexpr = "AUK_" nm }
  else {
    i = index($0, "// C: ")
    if (i == 0) next
    cexpr = substr($0, i + 6)
  }
  if (ty ~ /^[A-Z]/) {
    # an initializer of an opaque type: compared byte for byte
    ctyp = cof[mod "." ty]
    initauk[ki] = "    " ki " => {\n      let p: raw.Ptr<" mod "." ty "> = raw.cast(out)\n      p.store(" mod "." nm ")\n      i64(raw.size_of<" mod "." ty ">())\n    }"
    initc[ki] = "    { static " ctyp " v = " cexpr "; check_init(" ki ", &v, sizeof v, \"" cexpr "\"); }"
    ki++
  } else {
    # C's value as the declared type (SA_RESETHAND is 0x80000000 on Linux: an i32 there)
    ctyp = ty == "i64" ? "intptr_t" : ty == "usize" ? "size_t" : (ty ~ /^i/ ? "int" substr(ty, 2) "_t" : "uint" substr(ty, 2) "_t")
    emit(mod "." nm, "(" ctyp ")(" cexpr ")", cexpr)
  }
}

END {
  print "// Generated by runtime/test/abi/tables.awk: the Auk side of every size, offset and constant." > AUK
  print "export fn auk_probe(k: i32): i64 uses raw = match int(k) {" > AUK
  for (j = 0; j < k; j++) print aukt[j] > AUK
  print "    _ => -999999\n}\n" > AUK
  print "export fn auk_probe_init(k: i32, out: raw.Ptr<()>): i64 uses raw = match int(k) {" > AUK
  for (j = 0; j < ki; j++) print initauk[j] > AUK
  print "    _ => -1\n}" > AUK

  print "// Generated by runtime/test/abi/tables.awk: the C side." > C
  print "static void check_tables(void) {" > C
  print "  const struct { int64_t v; const char *what; } t[] = {" > C
  for (j = 0; j < k; j++) print ct[j] > C
  print "  };" > C
  print "  for (int i = 0; i < (int)(sizeof t / sizeof t[0]); i++) check_value(i, t[i].v, t[i].what);" > C
  print "  nchecked += (int)(sizeof t / sizeof t[0]);" > C
  for (j = 0; j < ki; j++) print initc[j] > C
  print "}" > C
}
