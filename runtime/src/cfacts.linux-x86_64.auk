pub raw let ET_DYN: i32 = 3 // C: ET_DYN
pub raw let SHT_SYMTAB: i32 = 2 // C: SHT_SYMTAB
pub raw let STT_FUNC: i32 = 2 // C: STT_FUNC
pub raw let SELFMAG: i32 = 4 // C: SELFMAG
pub raw let ELFMAG: u32 = 0x464c457f // "\x7fELF" as a little-endian u32
pub fn elf64_st_type(info: u8): u8 = info & 0xf

/// C: Elf64_Ehdr
pub raw struct Elf64Ehdr {
  e_ident: [u8; 16],
  e_type: u16,
  e_machine: u16,
  e_version: u32,
  e_entry: u64,
  e_phoff: u64,
  e_shoff: u64,
  e_flags: u32,
  e_ehsize: u16,
  e_phentsize: u16,
  e_phnum: u16,
  e_shentsize: u16,
  e_shnum: u16,
  e_shstrndx: u16,
}
raw assert raw.size_of<Elf64Ehdr>() == 64 && raw.align_of<Elf64Ehdr>() == 8
raw assert raw.offset_of<Elf64Ehdr>(.e_ident) == 0
raw assert raw.offset_of<Elf64Ehdr>(.e_type) == 16
raw assert raw.offset_of<Elf64Ehdr>(.e_machine) == 18
raw assert raw.offset_of<Elf64Ehdr>(.e_version) == 20
raw assert raw.offset_of<Elf64Ehdr>(.e_entry) == 24
raw assert raw.offset_of<Elf64Ehdr>(.e_phoff) == 32
raw assert raw.offset_of<Elf64Ehdr>(.e_shoff) == 40
raw assert raw.offset_of<Elf64Ehdr>(.e_flags) == 48
raw assert raw.offset_of<Elf64Ehdr>(.e_ehsize) == 52
raw assert raw.offset_of<Elf64Ehdr>(.e_phentsize) == 54
raw assert raw.offset_of<Elf64Ehdr>(.e_phnum) == 56
raw assert raw.offset_of<Elf64Ehdr>(.e_shentsize) == 58
raw assert raw.offset_of<Elf64Ehdr>(.e_shnum) == 60
raw assert raw.offset_of<Elf64Ehdr>(.e_shstrndx) == 62

/// C: Elf64_Shdr
pub raw struct Elf64Shdr {
  sh_name: u32,
  sh_type: u32,
  sh_flags: u64,
  sh_addr: u64,
  sh_offset: u64,
  sh_size: u64,
  sh_link: u32,
  sh_info: u32,
  sh_addralign: u64,
  sh_entsize: u64,
}
raw assert raw.size_of<Elf64Shdr>() == 64 && raw.align_of<Elf64Shdr>() == 8
raw assert raw.offset_of<Elf64Shdr>(.sh_name) == 0
raw assert raw.offset_of<Elf64Shdr>(.sh_type) == 4
raw assert raw.offset_of<Elf64Shdr>(.sh_flags) == 8
raw assert raw.offset_of<Elf64Shdr>(.sh_addr) == 16
raw assert raw.offset_of<Elf64Shdr>(.sh_offset) == 24
raw assert raw.offset_of<Elf64Shdr>(.sh_size) == 32
raw assert raw.offset_of<Elf64Shdr>(.sh_link) == 40
raw assert raw.offset_of<Elf64Shdr>(.sh_info) == 44
raw assert raw.offset_of<Elf64Shdr>(.sh_addralign) == 48
raw assert raw.offset_of<Elf64Shdr>(.sh_entsize) == 56

/// C: Elf64_Sym
pub raw struct Elf64Sym {
  st_name: u32,
  st_info: u8,
  st_other: u8,
  st_shndx: u16,
  st_value: u64,
  st_size: u64,
}
raw assert raw.size_of<Elf64Sym>() == 24 && raw.align_of<Elf64Sym>() == 8
raw assert raw.offset_of<Elf64Sym>(.st_name) == 0
raw assert raw.offset_of<Elf64Sym>(.st_info) == 4
raw assert raw.offset_of<Elf64Sym>(.st_other) == 5
raw assert raw.offset_of<Elf64Sym>(.st_shndx) == 6
raw assert raw.offset_of<Elf64Sym>(.st_value) == 8
raw assert raw.offset_of<Elf64Sym>(.st_size) == 16

