// ---- signal handler context (stack.c): the fault address, the interrupted PC and SP ----

pub raw let SIGINFO_ADDR: i64 = 24 // C: offsetof(siginfo_t, si_addr)
/// The mcontext pointer's offset in a ucontext_t (macOS: uc_mcontext is a pointer).
raw let UC_MCONTEXT: i64 = 48
raw let MC_PC: i64 = 272
raw let MC_SP: i64 = 264
fn mcontext(uc: raw.Ptr<()>): raw.Ptr<u8> uses raw {
  let p: raw.Ptr<raw.Ptr<u8>> = raw.cast(raw.cast<u8>(uc).offset(UC_MCONTEXT))
  p.load()
}
/// The interrupted program counter in a signal handler's ucontext (read or write it).
pub fn uc_pc(uc: raw.Ptr<()>): raw.Ptr<u64> uses raw = raw.cast(mcontext(uc).offset(MC_PC))
/// The interrupted stack pointer.
pub fn uc_sp(uc: raw.Ptr<()>): raw.Ptr<u64> uses raw = raw.cast(mcontext(uc).offset(MC_SP))
/// The faulting address of a SIGSEGV/SIGBUS (siginfo_t's si_addr).
pub fn si_addr(si: raw.Ptr<()>): raw.Ptr<()> uses raw {
  let p: raw.Ptr<raw.Ptr<()>> = raw.cast(raw.cast<u8>(si).offset(SIGINFO_ADDR))
  p.load()
}

// ---- C macros over values: wait status, file mode, control messages ----

pub fn wifexited(s: i32): bool = (s & 0x7f) == 0
pub fn wexitstatus(s: i32): i32 = (s >> 8) & 0xff
pub fn wifsignaled(s: i32): bool = (s & 0x7f) != 0 && (s & 0x7f) != 0x7f
pub fn wtermsig(s: i32): i32 = s & 0x7f
pub fn s_isdir(m: u32): bool = (m & S_IFMT) == S_IFDIR
pub fn s_isreg(m: u32): bool = (m & S_IFMT) == S_IFREG
raw let CMSG_ALIGN_TO: usize = 4
/// CMSG_ALIGN(sizeof(struct cmsghdr)): where a control message's data starts.
raw let CMSG_HDR: usize = (raw.size_of<Cmsghdr>() + CMSG_ALIGN_TO - 1) / CMSG_ALIGN_TO * CMSG_ALIGN_TO
pub fn cmsg_align(n: usize): usize = (n + CMSG_ALIGN_TO - 1) / CMSG_ALIGN_TO * CMSG_ALIGN_TO
pub fn cmsg_len(n: usize): usize = CMSG_HDR + n
pub fn cmsg_space(n: usize): usize = CMSG_HDR + cmsg_align(n)
pub fn cmsg_data(c: raw.Ptr<Cmsghdr>): raw.Ptr<u8> uses raw = raw.cast<u8>(c).offset(CMSG_HDR)
pub fn cmsg_firsthdr(m: raw.Ptr<Msghdr>): raw.Ptr<Cmsghdr> uses raw =
  if usize(m.msg_controllen) >= raw.size_of<Cmsghdr>() { raw.cast(m.msg_control) } else { raw.null() }

// ---- C library globals behind macros: errno, stdout, stderr ----

extern fn c_errno_location(): raw.Ptr<i32> = "int *__error(void)"
extern var c_stdout: raw.Ptr<()> = "__stdoutp"
extern var c_stderr: raw.Ptr<()> = "__stderrp"
/// The calling thread's errno.
pub fn errno_ptr(): raw.Ptr<i32> uses ffi = c_errno_location()
pub fn errno(): i32 uses raw, ffi = c_errno_location().load()
pub fn set_errno(e: i32) uses raw, ffi { c_errno_location().store(e) }
/// C's `stdout`/`stderr` (a FILE *).
pub fn stdout(): raw.Ptr<()> uses raw = c_stdout
pub fn stderr(): raw.Ptr<()> uses raw = c_stderr

// ---- only on macos ----

pub raw let DISPATCH_TIME_NOW: u64 = 0 // C: DISPATCH_TIME_NOW
pub raw let DISPATCH_TIME_FOREVER: u64 = 18446744073709551615 // C: DISPATCH_TIME_FOREVER
