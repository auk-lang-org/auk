/// A tiny website, built to be edited while it runs:
///
///   duck run --live src/main.duck        then open http://localhost:8080
///
/// It counts each page's visitors, and everyone shares a ❤ button, a guestbook, a note anyone can
/// edit as they type, and a duck of the day.
/// Supervised tasks share nothing and talk over channels:
/// - `counter` owns the state everyone shares (a `Stats`);
/// - `sessions` gives each browser a task of its own, holding what only that visitor sees (a `Mine`);
/// - `hub` pushes to open pages: after any click or edit, and after each `duck run --live` reload,
///   every open tab fetches at once (Server-Sent Events);
/// - `web` serves pages, each connection in a task of its own, asking `counter` and the visitor's
///   session for their parts of each page.
/// Pages are `splash` pages: they keep themselves current, so saved edits and other visitors'
/// clicks show up in open tabs without a reload.
/// See README.md for edits to try and what each one does to the running program.

/// What a request did: a visit to its page, a page refreshing itself (`Look`), or an event.
enum Act { Visit, Look, Like, Sign(name: str), Note(text: str), Pick(duck: str) }

/// A message to `counter`, answered on `reply` with what the page should show.
struct Hit { path: str, act: Act, reply: Chan<Shown> }

/// What a page shows.
/// `names`: the guestbook, newest first, each with its number (its key on the page).
struct Shown { visits: int, likes: int, names: [(int, str)], note: str, duck: str }

// ---- the counter: owns the state ----

/// The counter's state. TRY: add a field (`since: int`) and the counter task alone restarts.
struct Stats {
  hits: {str: int},
  total: int,
  likes: int,
  signed: int,
  names: [(int, str)],
  note: str,
  duck: str,
}

fn record(s: var Stats, path: str): int {
  s.hits[path] = (s.hits.get(path) else 0) + 1
  s.total += 1
  s.hits[path]
}

fn apply(s: var Stats, Visit, path: str) { let _ = record(&s, path) }
fn apply(_: var Stats, Look, _: str) {}
fn apply(s: var Stats, Like, _: str) { s.likes += 1 }
fn apply(s: var Stats, Sign(name), _: str) {
  let n = name.trim()
  if n != "" {
    s.signed += 1
    s.names = ([(s.signed, n)] + s.names).take(8)
  }
}
fn apply(s: var Stats, Note(text), _: str) {
  s.note = if text.len() > 200 { text[0..200] } else { text }
}
fn apply(s: var Stats, Pick(duck), _: str) {
  if DUCKS.contains(duck) {
    s.duck = duck
  }
}

/// The ducks to pick from.
let DUCKS = ["🦆 mallard", "🐣 duckling", "🦢 swan (close enough)", "🪿 goose (don't)"]

fn counter(hits: Chan<Hit>): ()! {
  var s = Stats { hits: {}, total: 0, likes: 0, signed: 0, names: [], note: "", duck: DUCKS[0] }
  for h in hits {
    apply(&s, h.act, h.path)
    let visits = s.hits.get(h.path) else 0
    h.reply.send(Shown { visits, likes: s.likes, names: s.names, note: s.note, duck: s.duck })
  }
}

// ---- sessions: what only one visitor sees ----

/// One visitor's own state. TRY: add a field and only the session tasks restart (each visitor's
/// count starts over); the shared counts stay.
struct Mine { clicks: int }

fn mine_update(m: Mine, splash.Click("mine", _)): Mine = Mine { clicks: m.clicks + 1 }
fn mine_update(m: Mine, _: splash.Event): Mine = m

fn mine_view(m: Mine): str = """
  <p><button splash-click="mine">just for me</button>
  You've clicked it <b>{m.clicks}</b> time(s). Only this browser sees that.</p>
  """

fn sessions(s: splash.Sessions): ()! =
  splash.run_sessions(s, () => Mine { clicks: 0 }, mine_update, mine_view, 1000)

// ---- the web server: stateless ----

/// The site's colors, on top of splash's defaults (the rest is in static/site.css). TRY: change a
/// color and save: open tabs restyle without a reload.
let CSS = splash.BASE_CSS + r"""
  body { background: #fdf6e3; color: #333; }
  @media (prefers-color-scheme: dark) { body { background: #1d2021; color: #ebdbb2; } }
  """

/// A file of `static/`, or none.
fn read_static(name: str): str? uses fs = match fs.read("static/{name}") {
  ok(text) => some(text)
  err(_) => none
}

/// How every page looks: read on each request, so an edit to static/site.css shows up live.
fn look(hub: splash.Hub, log: splash.Log): splash.Page uses fs = splash
  .titled("live-site")
  .with_css(CSS)
  .with_link(splash.asset("site.css", read_static("site.css") else ""))
  .with_hub(hub)
  .with_log(log)

/// The live part of the page. TRY: change the text or the colors and save: open tabs update,
/// the counts stay.
fn view(path: str, s: Shown, mine: str): str = """
  <h1>🦆 Hello from Duck</h1>
  <p>You are visitor <b>{s.visits}</b> of <code>{splash.escape(path)}</code>.</p>
  <p><button class="like" splash-click="like">❤ {s.likes}</button></p>
  {mine}
  <form splash-submit="sign">
    <input name="name" placeholder="your name" autocomplete="off">
    <button>sign the guestbook</button>
  </form>
  <ul>{s.names.map((k, n) => "<li splash-key=\"{k}\">{splash.escape(n)}</li>").join("")}</ul>
  <p>A note anyone can edit (other tabs see it as you type):</p>
  <input class="note" splash-input="note" value="{splash.escape(s.note)}" placeholder="say something" autocomplete="off">
  <blockquote>{splash.escape(s.note)}</blockquote>
  <p>Duck of the day:
    <select splash-change="duck">{DUCKS.map(d => option(d, s.duck)).join("")}</select>
  </p>
  <p><a href="/">home</a> · <a href="/pond">pond</a> · <a href="/boom">boom</a></p>
  """

fn option(d: str, chosen: str): str {
  let sel = if d == chosen { " selected" } else { "" }
  "<option{sel}>{splash.escape(d)}</option>"
}

/// What `req` did.
fn act(req: http.server.Req): Act = match splash.event(req) {
  some(splash.Click("like", _)) => Like
  some(splash.Submit("sign", fields)) => Sign(fields.get("name") else "")
  some(splash.Input("note", text)) => Note(text)
  some(splash.Change("duck", d)) => Pick(d)
  some(_) => Look
  none => if splash.is_poll(req) { Look } else { Visit }
}

/// The tasks and channels a request needs.
struct Site { hits: Chan<Hit>, mine: splash.Sessions, hub: splash.Hub, log: splash.Log }

fn handle(req: http.server.Req, site: Site): http.server.Reply uses fs {
  match splash.stream(req, site.hub) {
    some(r) => return r
    none => {}
  }
  match splash.static(req, f => read_static(f)) {
    some(r) => return http.server.Whole(r)
    none => {}
  }
  // TRY: `/boom` crashes this request's task: only its own connection drops, nothing restarts
  if req.path == "/boom" {
    let xs: [int] = []
    let _ = xs[1]
  }
  let reply: Chan<Shown> = chan()
  site.hits.send(Hit { path: req.path, act: act(req), reply })
  let shown = reply.recv() else Shown { visits: 0, likes: 0, names: [], note: "", duck: "" }
  let page = view(req.path, shown, splash.ask(site.mine, req))
  http.server.Whole(splash.answer(req, look(site.hub, site.log), page))
}

fn web(site: Site, port: int): ()! uses net, fs {
  eprint("listening on http://localhost:{port}")
  await http.server.serve_live("", port, req => handle(req, site))
}

// ---- main: starts the tree ----

fn main(): int! uses net, time, env, fs {
  let port = int.parse(env.get("PORT") else "8080") else 8080
  let hits: Chan<Hit> = chan()
  // SPLASH_LOG=info (or debug): what splash sends and receives, here and in the browser console
  let log = splash.log_level(env.get("SPLASH_LOG") else "")
  let site = Site {
    hits,
    mine: splash.sessions().with_log(log),
    hub: splash.hub().with_log(log),
    log,
  }
  let kids = [
    sup.child("counter", () => counter(site.hits)),
    sup.child("sessions", () => sessions(site.mine)),
    sup.child("hub", () => splash.run_hub(site.hub)),
    sup.child("web", () => web(site, port)),
  ]
  sup.run(kids, sup.one_for_one(10, 6_000))?
  0
}
