/// Random numbers (`uses rand`).

/// Uniform in `lo..=hi`.
pub extern fn int(lo: int, hi: int): int uses rand = "duck_rand_int"
/// Uniform in [0, 1).
pub extern fn float(): float uses rand = "duck_rand_float"
/// `n` bytes (ints 0..255) from the OS's cryptographic generator: for tokens, keys and ids.
/// Never affected by `seed`.
pub extern fn bytes(n: int): [int] uses rand = "duck_rand_bytes +loc"
/// Make `int`, `float`, `shuffle` and `choice` repeat the same sequence for the same seed (for
/// tests). They are fast, not cryptographic, seeded or not; use `bytes` for secrets.
pub extern fn seed(n: int) uses rand = "duck_rand_seed"
/// A copy of `xs` in random order.
pub fn shuffle<T>(xs: [T]): [T] uses rand {
  var out = xs
  var i = out.len() - 1
  while i > 0 {
    let j = int(0, i)
    let t = out[i]
    out[i] = out[j]
    out[j] = t
    i -= 1
  }
  out
}
/// A random element, or none for an empty list.
pub fn choice<T>(xs: [T]): T? uses rand {
  if xs.len() == 0 { return none }
  xs[int(0, xs.len() - 1)]
}
