/// Windows (`uses gui`): open native windows, show pixels you draw, and read input. The windows
/// belong to a separate window process that the first `open` starts. A window is an int id; it
/// can be passed to other tasks and stays open until `close`. Under `duck run --live`, a
/// restarted program's `open` with the same title takes over the window it had. Sizes and
/// positions are physical pixels (`scale(win)` of them per logical point: 2.0 on a Retina
/// display). macOS only so far.
///
/// What a window shows is a `pixels.Frame`, shown one frame pixel per window pixel from the
/// top-left and opaque (its transparency is ignored).

/// Input to a window. Mouse buttons: 0 left, 1 right, 2 middle. `mods` bits: 1 Shift,
/// 2 Control, 4 Option/Alt, 8 Command. `KeyDown`/`KeyUp` carry the platform's key code;
/// typed characters come as `Text`.
pub enum Event {
  Close,
  Resize(w: int, h: int),
  MouseMove(x: int, y: int),
  MouseDown(button: int, x: int, y: int, mods: int),
  MouseUp(button: int, x: int, y: int, mods: int),
  Scroll(dx: float, dy: float),
  KeyDown(code: int, mods: int, repeat: bool),
  KeyUp(code: int, mods: int),
  Text(text: str),
  Focus(on: bool),
}

/// Open a window whose content is `w` by `h` logical points, titled `title`; returns its id.
pub extern fn open(title: str, w: int, h: int): int! uses gui = "duck_gui_open"
/// Close a window. Its id then reports `Close` from `next_event` and 0 from `width`/`height`.
pub extern fn close(win: int) uses gui = "duck_gui_close"
/// The content width in physical pixels.
pub extern fn width(win: int): int uses gui = "duck_gui_width"
/// The content height in physical pixels.
pub extern fn height(win: int): int uses gui = "duck_gui_height"
/// Physical pixels per logical point.
pub extern fn scale(win: int): float uses gui = "duck_gui_scale"
/// Show the rectangles `rects` of the frame `f` in the window, given as `x, y, w, h` four ints at
/// a time; the rest of what it shows stays as it was. Only those rectangles are copied, and they
/// reach the window together. `graphics.canvas` works out which rectangles changed for you.
pub extern fn present_rects(win: int, f: pixels.Frame, rects: [int]): ()! uses gui = "duck_gui_present_rects"

/// Show the `w` by `h` rectangle at (`x`, `y`) of the frame `f` in the window; the rest of what
/// it shows stays as it was. Only that rectangle is copied, so a small change is cheap to show.
pub fn present_rect(win: int, f: pixels.Frame, x: int, y: int, w: int, h: int): ()! uses gui = present_rects(win, f, [x, y, w, h])

/// Show the whole frame `f` in the window.
pub fn present(win: int, f: pixels.Frame): ()! uses gui = present_rect(win, f, 0, 0, f.width(), f.height())

extern fn next_raw(win: int, ms: int): [int] uses gui = "duck_gui_next_event +loc"

/// The window's next event, waiting at most `ms` milliseconds (0: don't wait, -1: until one
/// comes); none if none came in time. The close button sends `Close` and leaves the window open
/// until you `close` it.
pub fn next_event(win: int, ms: int): Event? uses gui = match next_raw(win, ms) {
  [1] => some(Close)
  [2, w, h] => some(Resize(w, h))
  [3, x, y] => some(MouseMove(x, y))
  [4, b, x, y, m] => some(MouseDown(b, x, y, m))
  [5, b, x, y, m] => some(MouseUp(b, x, y, m))
  [6, dx, dy] => some(Scroll(float(dx) / 100.0, float(dy) / 100.0))
  [7, k, m, r] => some(KeyDown(k, m, r == 1))
  [8, k, m] => some(KeyUp(k, m))
  [9, ..b] => some(Text(str.from_utf8(b) else ""))
  [10, on] => some(Focus(on == 1))
  _ => none
}
