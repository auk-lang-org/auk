test "hidden is_valid_date" {
  assert is_valid_date("2024-02-29")
  assert !is_valid_date("2023-02-29")
  assert !is_valid_date("1900-02-29")
  assert is_valid_date("2000-02-29")
  assert !is_valid_date("2023-04-31")
  assert is_valid_date("2023-12-31")
  assert is_valid_date("0001-01-01")
  assert is_valid_date("9999-12-31")
  assert !is_valid_date("2023-13-01")
  assert !is_valid_date("2023-00-10")
  assert !is_valid_date("2023-01-00")
  assert !is_valid_date("0000-01-01")
  assert !is_valid_date("2023-1-01")
  assert !is_valid_date("2023-01-01 ")
  assert !is_valid_date("abcd-ef-gh")
  assert !is_valid_date("")
  assert !is_valid_date("+023-01-01")
  assert !is_valid_date("2023-+1-01")
  assert !is_valid_date("2023-01- 1")
  assert !is_valid_date("2023/01/01")
  assert !is_valid_date("20230-1-01")
  assert is_valid_date("2023-06-15")
}
