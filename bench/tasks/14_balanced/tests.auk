test "hidden balanced" {
  assert balanced("([]{{}})")
  assert !balanced("([)]")
  assert balanced("")
  assert balanced("no brackets")
  assert !balanced("((")
  assert !balanced("))")
  assert !balanced("}}{{")
  assert balanced("a(b[c]d)e")
  assert balanced("{{[()()]}}")
  assert !balanced("{{[()()]}}]")
  assert !balanced("(")
  assert !balanced("]")
  assert balanced("f(x) = [y{{z}}]")
}
