/// ORC LLJIT (src/mir/llvm/jit.rs, and running the entry point as src/mir/exec.rs does): one
/// JIT instance per compiled program, with the runtime linked into this process as absolute
/// symbols. ORC only links: the program arrives as an object file compiled by our own target
/// machine (the same code generation as `auk build`), so nothing compiles lazily.
///
/// Rust hands ORC a table of every runtime entry point generated by its build script. This
/// compiler is itself an Auk program with the runtime linked in (and `auk build` exports its
/// symbols), so each runtime symbol the module calls is looked up in this process with
/// `ffi.symbol` (`dlsym`) and defined at that address; anything else (libc's `memcpy`, a user
/// C library's functions) is found by ORC's process search generator.

/// A program's code in memory; `close` frees it.
pub struct Code { j: llvm.OrcLLJIT }

/// Link object file `obj` into memory, with the runtime symbols `syms` it calls.
pub fn load(obj: [int], syms: [str]): Code! uses ffi {
  llvm.kit.init_native()
  var jr: llvm.OrcLLJIT? = none
  llvm.kit.check(llvm.orc.orc_create_lljit(&jr, llvm.orc.orc_create_lljit_builder()))?
  let j = jr!
  let jd = llvm.orc.orc_lljit_get_main_jit_dylib(j)
  let jt = llvm.kit.Jit { j, dylib: jd }
  // the runtime linked into this process
  var pairs: [(str, ffi.Ptr)] = []
  for s in syms.sort() {
    match ffi.symbol(s) {
      some(at) => pairs.push((s, at))
      none => {}
    }
  }
  llvm.kit.define(jt, pairs)?
  // libc and friends (memcpy, memset, ... that LLVM may call)
  var gen: llvm.OrcDefinitionGenerator? = none
  let prefix = llvm.orc.orc_lljit_get_global_prefix(j)
  llvm.kit.check(
    llvm.orc.orc_create_dynamic_library_search_generator_for_process(
      &gen,
      prefix,
      ffi.null,
      ffi.null,
    ),
  )?
  llvm.orc.orc_jit_dylib_add_generator(jd, gen!)
  llvm.kit.add_object(jt, obj)?
  Code { j }
}

/// The address of an exported function (linking the module the first time).
pub fn lookup(c: Code, name: str): ffi.Ptr! uses ffi {
  var a = 0
  match llvm.kit.check(llvm.orc.orc_lljit_lookup(c.j, &a, name)) {
    ok(_) => ffi.ptr(a)
    err(e) => fail("looking up {name}: {e}")
  }
}

/// Free the code.
pub fn close(c: Code) uses ffi {
  let _ = llvm.kit.check(llvm.orc.orc_dispose_lljit(c.j))
}

extern fn c_call_entry(f: ffi.Ptr, argc: int, argv: ffi.Ptr): int = "int (*)(int, void *)"
extern fn c_leak_baseline() = "void auk_leak_baseline(void)"

/// Call the entry point `int f(int argc, char **argv)` with these arguments (`argv[0]` first);
/// returns its exit code. The program shares this process's runtime, so its leak check
/// (`AUK_LEAK_CHECK=1`) counts the objects live from the call on: the compiler's own aren't its.
pub fn run(entry: ffi.Ptr, args: [str]): int uses ffi {
  let argv = ffi.alloc(8 * (args.len() + 1))
  var cs: [ffi.Ptr] = []
  for i, a in args {
    let c = ffi.from_bytes(a.bytes() + [0])
    cs.push(c)
    ffi.write_ptr(argv, 8 * i, c)
  }
  ffi.write_ptr(argv, 8 * args.len(), ffi.null)
  c_leak_baseline()
  let code = c_call_entry(entry, args.len(), argv)
  for c in cs { ffi.free(c) }
  ffi.free(argv)
  code
}

/// The file names `dlopen` tries for the C library `l` (`[link] libs`): `lib<l>.dylib` (also
/// under Homebrew's prefixes) on macOS, `lib<l>.so` (and `.so.0`, `.so.1`) elsewhere; a name
/// with a `/` is a path.
pub fn lib_files(l: str): [str] uses ffi {
  if l.contains("/") { return [l] }
  if paths.os() == "macos" {
    ["", "/opt/homebrew/lib/", "/usr/local/lib/"].map(d => "{d}lib{l}.dylib")
  } else {
    ["lib{l}.so", "lib{l}.so.0", "lib{l}.so.1"]
  }
}

extern fn c_dlopen(path: str, mode: int): ffi.Ptr? = "void *dlopen(const char *, int)"
extern fn c_dlerror(): str? = "char *dlerror(void)"

/// Load the C libraries a program names (`[link] libs`, `RTLD_GLOBAL`) and check that every C
/// function it calls (`extern fn` with a C prototype) resolves in this process; the JIT then
/// finds them through its process symbol generator.
pub fn open_libs(links: [str], syms: [str]): ()! uses env, proc, ffi {
  let macos = paths.os() == "macos"
  // RTLD_NOW | RTLD_GLOBAL
  let mode = if macos { 2 + 8 } else { 2 + 256 }
  for l0 in links {
    let l = expand_link(l0)?
    let names = lib_files(l)
    var last = ""
    var found = false
    for n in names {
      match c_dlopen(n, mode) {
        some(_) => {
          found = true
          break
        }
        none => match c_dlerror() {
          some(e) => last = e
          none => {}
        }
      }
    }
    if !found {
      let hint = if l.contains("/") {
        "no library at {l}; for a path that differs by OS, name it under [link] macos = [..] or linux = [..]"
      } else if macos {
        "brew install {l}"
      } else {
        "install the {l} development package (e.g. lib{l}-dev)"
      }
      return fail("error: cannot load the C library `{l}` (raft.toml [link] libs; tried {names.join(", ")}): {last}\n  help: {hint}\n")
    }
  }
  var missing: [str] = []
  for s in syms {
    if ffi.symbol(s) == none { missing.push("`{s}`") }
  }
  if missing.len() > 0 {
    let libs = if links.len() == 0 {
      "no libraries are linked"
    } else {
      "linked: {links.join(", ")}"
    }
    return fail("error: C function {missing.join(", ")} not found ({libs})\n  help: name the library that defines it in raft.toml: [link] libs = [\"name\"]\n")
  }
}

/// A `[link]` entry with `${VAR}`, `${VAR:-default}` and `$(tool args)` expanded
/// (src/resolve.rs `expand_link`).
pub fn expand_link(l: str): str! uses env, proc {
  let bad = (why: str) => "error: raft.toml [link] `{l}`: {why}\n"
  var out: [str] = []
  var rest = l
  loop {
    let i = rest.find("$") else break
    out.push(rest[0..i])
    let after = rest[i + 1..rest.len()]
    if after.starts_with("{{") {
      let body = after[1..after.len()]
      let end = body.find("}}") else return fail(bad("`${{` without its `}}`"))
      let inner = body[0..end]
      let (var_name, default) = match inner.find(":-") {
        some(k) => (inner[0..k], some(inner[k + 2..inner.len()]))
        none => (inner, none)
      }
      let v = match env.get(var_name) {
        some(v) => if v == "" { none } else { some(v) }
        none => none
      }
      match (v, default) {
        (some(v), _) => out.push(v)
        (none, some(d)) => out.push(expand_link(d)?)
        (none, none) => return fail(
          bad("the environment variable `{var_name}` is not set (`${{{var_name}:-default}}` gives a default)"),
        )
      }
      rest = body[end + 1..body.len()]
    } else if after.starts_with("(") {
      let body = after[1..after.len()]
      var depth = 1
      var end: int? = none
      for k, c in body.chars() {
        if c == '(' { depth += 1 }
        if c == ')' { depth -= 1 }
        if depth == 0 {
          end = k
          break
        }
      }
      let e = end else return fail(bad("`$(` without its `)`"))
      let cmd = expand_link(body[0..e])?
      let words = split(cmd)
      if words.len() == 0 { return fail(bad("`$()` names no tool")) }
      let o = match proc.run(words[0], words.skip(1)) {
        ok(o) => o
        err(x) => return fail(bad("`{cmd}` failed: {x}"))
      }
      out.push(o.trim())
      rest = body[e + 1..body.len()]
    } else {
      out.push("$")
      rest = after
    }
  }
  out.push(rest)
  out.join("")
}
