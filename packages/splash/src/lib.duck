/// Live pages, LiveView-style: the server renders a view to HTML, and the page keeps itself
/// current. Its script re-fetches the page in the background and swaps the view in place when it
/// changed, so new state, other visitors' actions and (under `duck run --live`) saved code all
/// show up in open tabs within a moment: no reload, no flash, the scroll position stays.
///
/// v0.1 polls (`every` ms, a request with the `x-splash` header): the `http` server answers one
/// connection at a time and closes each, so it can't hold a push channel open yet. The API is
/// meant to stay the same when it can.

/// The header a page's refresh requests carry.
pub let POLL_HEADER = "x-splash"

/// How often an open page asks for a fresh view, by default (ms).
pub let EVERY = 500

/// Is `req` an open page asking for a fresh view, rather than a visit? Don't count it as one,
/// and don't do a visit's side effects for it.
pub fn is_poll(req: http.server.Req): bool = req.headers.get(POLL_HEADER) is some(_)

/// A whole HTML page showing `view` (HTML), titled `title`, that keeps itself current.
pub fn page(title: str, view: str): str = page_every(title, view, EVERY)

/// `page`, asking for a fresh view every `every` ms.
pub fn page_every(title: str, view: str, every: int): str = """
  <!doctype html>
  <html>
  <head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{escape(title)}</title></head>
  <body style="margin: 0">
  <main id="splash">{view}</main>
  {script(every)}
  </body>
  </html>
  """

/// The page's refresh script on its own (for a page built by hand: the live part must be the
/// element with `id="splash"`).
pub fn script(every: int): str = "<script>const splashEvery = {every};</script>" + r"""
  <script>
  setInterval(async () => {
    try {
      const r = await fetch(location.href, { headers: { "x-splash": "1" } });
      const doc = new DOMParser().parseFromString(await r.text(), "text/html");
      const now = document.getElementById("splash"), next = doc.getElementById("splash");
      if (now && next && next.outerHTML !== now.outerHTML) { now.replaceWith(next); }
    } catch (e) {}  // the server is away (restarting): try again next time
  }, splashEvery);
  </script>
  """

/// A 200 response with `page(title, view)`.
pub fn respond(title: str, view: str): http.Resp = http.Resp {
  status: 200,
  headers: {"content-type": "text/html; charset=utf-8"},
  body: page(title, view),
}

/// Serves live pages on `port` (every interface) forever: `view(req)` renders each one (its
/// HTML), and `title` names them.
pub async fn serve(port: int, title: str, view: (http.server.Req) => str): ()! uses net {
  await http.server.serve("", port, req => respond(title, view(req)))
}

/// `s` as HTML text: `&`, `<`, `>`, `"` and `'` escaped. Put anything a user typed through this.
pub fn escape(s: str): str = s
  .replace("&", "&amp;")
  .replace("<", "&lt;")
  .replace(">", "&gt;")
  .replace("\"", "&quot;")
  .replace("'", "&#39;")

// ---- tests ----

fn req(headers: {str: str}): http.server.Req =
  http.server.Req { method: "GET", target: "/", path: "/", query: "", headers, body: "" }

test "a page wraps the view in the live element and refreshes itself" {
  let p = page("Home & away", "<p>hi</p>")
  assert p.contains("<main id=\"splash\"><p>hi</p></main>")
  assert p.contains("<title>Home &amp; away</title>")
  assert p.contains("\"x-splash\": \"1\"")
  assert p.contains("const splashEvery = 500;")
}

test "page_every sets the interval" {
  assert page_every("t", "", 2000).contains("const splashEvery = 2000;")
}

test "is_poll tells a refresh from a visit" {
  assert is_poll(req({"x-splash": "1"}))
  assert !is_poll(req({}))
}

test "respond is a 200 HTML page" {
  let r = respond("t", "<b>x</b>")
  assert r.status == 200
  assert r.headers["content-type"] == "text/html; charset=utf-8"
  assert r.body.contains("<b>x</b>")
}

test "escape" {
  assert escape("<a href=\"x\">Tom & Jerry's</a>") ==
    "&lt;a href=&quot;x&quot;&gt;Tom &amp; Jerry&#39;s&lt;/a&gt;"
  assert escape("plain") == "plain"
}
